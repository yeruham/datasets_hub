# lakeFS connection
LAKEFS_HOST=http://localhost:8000
LAKEFS_USERNAME=your-access-key
LAKEFS_PASSWORD=your-secret-key
LAKEFS_STORAGE_NAMESPACE=s3://your-bucket/lakefs

# Validation integration (datasets_hub)
DATASETS_HUB_VALIDATION_ENABLED=true
DATASETS_HUB_VALIDATION_REQUIRED=true
DATASETS_HUB_VALIDATION_PROFILE_FILENAME=lakefs_validation.json
DATASETS_HUB_VALIDATION_METADATA_KEY=profile
DATASETS_HUB_VALIDATION_SERVICE_URL=http://localhost:8080
DATASETS_HUB_VALIDATION_SYNC_ON_COMMIT=true
DATASETS_HUB_VALIDATION_AUTO_SCAFFOLD=true
DATASETS_HUB_VALIDATION_IDE_SETUP=true
# Optional: host schema on HTTPS for .vscode/settings.json (otherwise uses ./.lakefs/)
# DATASETS_HUB_VALIDATION_SCHEMA_URL=https://your-org/schemas/lakefs_validation.schema.json
# DATASETS_HUB_VALIDATION_REGISTRY_API_KEY=change-me-in-production
